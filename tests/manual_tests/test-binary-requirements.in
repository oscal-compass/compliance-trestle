# Source file for tests/manual_tests/test-binary-requirements.txt
#
# To regenerate test-binary-requirements.txt (after pyproject.toml dep changes):
#
#   python -m venv /tmp/trestle_resolve
#   /tmp/trestle_resolve/bin/pip install pip-tools
#   /tmp/trestle_resolve/bin/pip-compile \
#       --generate-hashes \
#       --no-annotate \
#       --no-header \
#       --output-file tests/manual_tests/test-binary-requirements.txt \
#       tests/manual_tests/test-binary-requirements.in
#
# This file pins ALL runtime deps (from pyproject.toml [project].dependencies)
# plus the test-runner tools so that `pip install --require-hashes -r ...` in
# tests/manual_tests/test_binary.sh can fully provision the isolated venv
# before the wheel itself is installed with --no-deps.

